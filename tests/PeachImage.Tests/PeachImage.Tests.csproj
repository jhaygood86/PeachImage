<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>PeachImage.Tests</RootNamespace>
    <NoWarn>$(NoWarn);CS1591;CA1707;CA1859</NoWarn>
    <!--
      dotnet test runs this project's TFMs (net8.0/net10.0) in parallel by default (SDK 9+). On a fresh
      checkout with no tests/corpus/ yet, both TFM processes race to auto-fetch it over the network at the
      same time (CorpusFetcher), writing the same destination files concurrently — producing corrupt/partial
      corpus files and, since Directory.GetFiles-backed MemberData can enumerate mid-fetch, spurious "no data
      found" theory failures. Serializing the TFMs means the first one fully populates the corpus (and writes
      its marker file) before the second starts, so it just sees the marker and skips fetching.
    -->
    <TestTfmsInParallel>false</TestTfmsInParallel>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="6.0.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="SkiaSharp" Version="4.151.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="4.151.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.151.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PeachImage\PeachImage.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      A genuine, real-world ICC profile (color.org's sRGB2014.icc reference profile, licensed by the
      International Color Consortium for unrestricted copying/distribution/embedding) for TIFF ICC-extraction
      tests; see TiffIccProfileTests. Embedded rather than copied to the output directory so tests don't
      depend on the working directory a given test runner launches from.
    -->
    <EmbeddedResource Include="Formats/Tiff/Assets/reference-srgb.icc">
      <LogicalName>PeachImage.Tests.Formats.Tiff.Assets.reference-srgb.icc</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!-- Tiny JPEG XL files produced with libjxl (via ffmpeg's libjxl encoder) for header/container tests. -->
    <EmbeddedResource Include="Formats/Jxl/Assets/*">
      <LogicalName>PeachImage.Tests.Formats.Jxl.Assets.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!-- CCITT-compressed TIFFs written by libtiff (via Pillow), with PNG references of the source bitmaps. -->
    <EmbeddedResource Include="Formats/Tiff/Assets/Ccitt/*">
      <LogicalName>PeachImage.Tests.Formats.Tiff.Assets.Ccitt.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!-- JBIG2 streams written by Assets/jbig2gen.py, with the pages they must decode to; checked against MuPDF's jbig2dec when generated. -->
    <EmbeddedResource Include="Formats/Jbig2/Assets/*.png;Formats/Jbig2/Assets/*.jb2;Formats/Jbig2/Assets/*.seg;Formats/Jbig2/Assets/*.glb">
      <LogicalName>PeachImage.Tests.Formats.Jbig2.Assets.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!-- JPEG 2000 files written by Assets/j2kgen.py (Pillow/OpenJPEG) with OpenJPEG's own decode of each as the reference PNG. -->
    <EmbeddedResource Include="Formats/Jpeg2000/Assets/*.png;Formats/Jpeg2000/Assets/*.jp2;Formats/Jpeg2000/Assets/*.j2k;Formats/Jpeg2000/Assets/*.ref.raw">
      <LogicalName>PeachImage.Tests.Formats.Jpeg2000.Assets.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
