<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>PeachImage.Benchmarks</RootNamespace>
    <NoWarn>$(NoWarn);CS1591;CA1707;CA1001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageReference Include="Quamotion.TurboJpegWrapper" Version="2.0.32" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PeachImage\PeachImage.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Assets\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
